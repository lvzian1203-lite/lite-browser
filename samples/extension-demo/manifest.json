{
  "manifest_version": 3,
  "name": "lite browser 示例扩展",
  "version": "1.0.0",
  "description": "在页面顶部插入一条横幅，用于验证 Chrome 扩展接口是否生效（MV3）。",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
